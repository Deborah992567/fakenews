# Application server
HOST=0.0.0.0
PORT=8000
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Model / vectorizer files
MODEL_PATH=my_model.h5
VECTORIZER_PATH=countvectorizer.pkl

# Prediction behaviour
# Verdict is "uncertain" when the winning probability is within this distance of 50%.
UNCERTAINTY_THRESHOLD=0.10
# How many influential words to return in the explanation.
TOP_FEATURES=10

# Input validation
MAX_INPUT_LENGTH=20000

# URL analysis
MAX_URL_RESPONSE_SIZE=1000000
REQUEST_TIMEOUT=10
MAX_REDIRECTS=5

# CORS (comma-separated origins; use * for all during development)
CORS_ORIGINS=*
